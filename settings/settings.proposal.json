  "model": "opus[1m]",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{home}/.claude/hooks/cc-status"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{home}/.claude/hooks/cc-status"
          },
          {
            "type": "command",
            "command": "{home}/.claude/hooks/prompt-log.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{home}/.claude/hooks/cc-status"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{home}/.claude/hooks/no-blind-stage.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{home}/.claude/hooks/no-shell-file-write.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{home}/.claude/hooks/sandbox-semantics.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{home}/.claude/hooks/gh-api-writes.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{home}/.claude/hooks/rm-scope.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__ccd_directory__.*|EnterWorktree|ExitWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "{home}/.claude/hooks/directory-scope.py",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "{home}/.claude/hooks/cc-status"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{home}/.claude/hooks/cc-status"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{home}/.claude/hooks/cc-status"
          },
          {
            "type": "command",
            "command": "{home}/.claude/hooks/install-drift.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{home}/.claude/hooks/cc-status"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{home}/.claude/hooks/cc-status"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{home}/.claude/hooks/cc-status"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{home}/.claude/hooks/cc-status"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{home}/.claude/hooks/worktree.py",
            "timeout": 120
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{home}/.claude/hooks/worktree.py",
            "timeout": 60
          }
        ]
      }
    ]
  },
