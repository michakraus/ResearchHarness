<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{launchd_prefix}.kaimon</string>

    <!-- The server and every session it runs for an agent under the Seatbelt profile that
         `harness setup` renders from sandbox/daemon.toml: of the home directory, it reads and
         writes only ~/Research and the other paths that file lists. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/sandbox-exec</string>
        <string>-f</string>
        <string>{home}/.config/research-harness/sandbox/kaimon.sb</string>
        <string>{home}/.julia/bin/kaimon</string>
        <string>--headless</string>
        <string>--port</string>
        <string>2828</string>
    </array>

    <!-- LOAD-BEARING. Kaimon reads its tool policy from .kaimon/tools.json resolved
         against the server process's pwd(). Started anywhere else, the entire policy
         is SILENTLY ignored and all 53 default tools are advertised, including
         pkg_add, pkg_rm and the agent_* family. This is the launchd expression of the
         documented `cd ~/Research && kaimon ...`. Do not remove it. -->
    <key>WorkingDirectory</key>
    <string>{home}/Research</string>

    <!-- A persistent server, not an interval job: start at login, restart on exit. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Without this, a failure to bind port 2828 (typically a second server already
         running) becomes a restart loop several times a second. -->
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>{home}/Library/Logs/kaimon/launchd.out</string>
    <key>StandardErrorPath</key>
    <string>{home}/Library/Logs/kaimon/launchd.err</string>

    <!-- Adaptive, not Background: this must answer MCP calls promptly, unlike the
         research-sync job which is deliberately deprioritised. -->
    <key>ProcessType</key>
    <string>Adaptive</string>

    <!-- JULIA_APPS_JULIA_CMD is what decides which Julia runs, and it is here rather than
         left to the shim on purpose. The Pkg-generated shim hardcodes an absolute juliaup
         path; on 2026-09-07 the release it named (julia-1.13.0-rc3) was removed by an
         upgrade and the job could no longer start — "command not found", which reads as a
         broken Julia install rather than a stale pin. Pkg rewrites that line on every
         `Pkg.Apps.add`, so a fix in the shim alone does not stay fixed. The launcher
         resolves juliaup's default channel instead of naming one release.

         PATH is not needed to start the job (the shim exports JULIA_DEPOT_PATH and
         JULIA_LOAD_PATH itself). It is set for the subprocesses Kaimon spawns — git, and
         Julia's own tooling — which otherwise get launchd's minimal default PATH. Its first
         directory holds the `ps` that `harness setup` installs from sandbox/shims/: the exec
         of the setuid /bin/ps fails under the Seatbelt profile, and Kaimon reads that failure
         as a dead session, so the shim answers Kaimon's `ps -o state= -p PID` with `kill -0`.
         The profile lets the job read that directory and not write it.

         KAIMON_QDRANT_MANAGED=off stops the background indexing, which the qdrant_* entries
         in tools.json do not stop. The package preference of the same name lives in the app
         environment, and every Kaimon update deletes it; this variable overrides it and
         stays.

         KAIMON_GATE_PROMOTE_AFTER=240 lets an `ex` call wait up to 240 s for its result before
         Kaimon makes it a background job. An agent that gets a job id has no way to wait, so it
         calls check_eval until the job ends: in Antigravity, every 8 s (the median), each
         call a model turn that reads the whole context. 240 s stays inside the 5-minute prompt
         cache of a Claude Code sub-agent; oh-my-pi's request timeout for Kaimon is above it.

         POCL_CACHE_DIR gives the PoCL of a Julia session its own kernel cache, which the profile
         lets the job write: it denies PoCL's default ~/.cache/pocl, which a sandboxed command may
         write, so no command can put a compiled kernel where Kaimon loads and runs it.
         `harness setup` creates the directory before it loads the job.

         JULIA_PKG_OFFLINE=true starts Pkg offline in the server and in every session, which
         inherits the server's environment: the profile allows outbound connections to the
         loopback addresses and Kaimon's own sockets only, so no package server is reachable.
         Pkg then updates no registry and resolves against the installed versions alone. A
         session's own `julia` or the julia-update job downloads a package that is missing. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>JULIA_APPS_JULIA_CMD</key>
        <string>{home}/.juliaup/bin/julia</string>
        <key>PATH</key>
        <string>{home}/.config/research-harness/sandbox/shims:{home}/.juliaup/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>KAIMON_QDRANT_MANAGED</key>
        <string>off</string>
        <key>KAIMON_GATE_PROMOTE_AFTER</key>
        <string>240</string>
        <key>POCL_CACHE_DIR</key>
        <string>{home}/.cache/kaimon/pocl</string>
        <key>JULIA_PKG_OFFLINE</key>
        <string>true</string>
    </dict>
</dict>
</plist>
