#!/usr/bin/env python3
"""claude-autocommit: commit ~/.claude's plan files and project memories on a timer.

    canonical copy   ~/Research/Harness/launchagents/claude-autocommit
    installed copy   ~/.local/bin/claude-autocommit        (edit here, then reinstall)
    launched by      claude-autocommit.plist on macOS, systemd/claude-autocommit.timer on Linux,
                     each rendered with the profile, on the interpreter of the harness's Python
                     environment

WHY THE SCOPE IS TWO DIRECTORIES

An automatic commit is a sweep, and ~/.claude is the tree where sweeps are most dangerous: several
sessions write to it at once. So this stages explicit paths and covers only the two kinds of
tracked content that nobody will ever want a hand-written message for: a plan file is one
session's by-product with a generated name, and a memory file is one self-describing fact.
settings.json, CLAUDE.md, RTK.md, agents/, skills/, hooks/, CHANGELOG.md and plugins/*.json are
authored, each carries a changelog round, and this job never touches them.

It commits with an explicit pathspec, so anything another session has left *staged* stays staged
and uncommitted. That is the whole safety property; do not "simplify" it into a bare `git commit`.

EXIT CODES

  0  committed, or nothing to do, or deferred (another run, a locked index, quiescence)
  1  something is wrong and a human should look; never used for "nothing to do"
"""

import contextlib
import io
import os
import pathlib
import shutil
import signal
import socket
import stat
import subprocess
import sys
import time
from collections.abc import Sequence
from types import FrameType
from typing import NoReturn

USAGE = """\
usage: claude-autocommit [--dry-run] [--no-push] [--help]

Commits ~/.claude/plans/ and ~/.claude/projects/*/memory/ and pushes the local main to
origin's $CLAUDE_AUTOCOMMIT_BRANCH, main by default. Nothing else in ~/.claude is touched.

  --dry-run   report what would be committed; take no lock and write nothing
  --no-push   commit but do not push

environment
  CLAUDE_AUTOCOMMIT_REPO           default $HOME/.claude
  CLAUDE_AUTOCOMMIT_QUIESCE_MIN    skip files modified within N minutes (default 5)
  CLAUDE_AUTOCOMMIT_MAX_DELETIONS  refuse a run deleting more than N files (default 20)
  CLAUDE_AUTOCOMMIT_PUSH           0 to never push (default 1)
  CLAUDE_AUTOCOMMIT_BRANCH         the branch of origin to push to (default main)
"""
LOCK_STALE_MIN = 30
# A git pathspec is matched against each *file* path, so `projects/*/memory` would match nothing at
# all and read as "nothing to commit"; the trailing /* is what makes it match the memory files.
SPEC = ("plans", "projects/*/memory/*")
# The seconds that one git command may take, so that a hung remote cannot hold the lock forever.
GIT_TIMEOUT = 600
# The output of a git command that failed because another process holds the index.
LOCKED = ("index.lock", "Unable to create")


def setting(name: str, default: str) -> str:
    """The value of the environment variable `name`, or `default` where it is unset or empty."""
    return os.environ.get(name) or default


def say(message: str) -> None:
    print(f"{time.strftime('%Y-%m-%d %H:%M:%S')} claude-autocommit: {message}", flush=True)


def warn(message: str) -> None:
    print(f"{time.strftime('%Y-%m-%d %H:%M:%S')} claude-autocommit: {message}", file=sys.stderr, flush=True)


def die(message: str) -> NoReturn:
    warn(f"ERROR: {message}")
    raise SystemExit(1)


def integer(name: str, default: str) -> int:
    """The integer setting `name`; a value that is not an integer is an error."""
    value = setting(name, default)
    try:
        return int(value)
    except ValueError:
        die(f"{name} is not an integer: {value!r}")


def git_command(*args: str) -> list[str]:
    """The git of the PATH with `args`."""
    found = shutil.which("git")
    if found is None:
        die("no git on the PATH")
    return [found, *args]


class Run:
    """The git that runs, and whether a SIGTERM has come. A killed git leaves its index.lock, and
    every later run then defers without end, so a SIGTERM never kills git: the handler sends it on
    to the running git, which removes its own lock, and the run stops after that git."""

    child: subprocess.Popen[bytes] | None = None
    terminated = False


def run_git(args: Sequence[str], stdin: bytes | None, *, merged: bool) -> tuple[int, bytes, bytes]:
    """git with `args` in the working directory and `stdin` on its stdin (None: this process's):
    its exit status, stdout and stderr, with stderr in stdout where `merged`. A git that takes
    longer than GIT_TIMEOUT gets a SIGTERM, and the run ends with one ERROR line once it has
    ended. After a SIGTERM to the run, the run ends here once git has ended, with the lock removed
    on the way out."""
    with subprocess.Popen(
        git_command(*args),
        stdin=None if stdin is None else subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT if merged else subprocess.PIPE,
    ) as p:
        Run.child = p
        try:
            out, err = p.communicate(stdin, timeout=GIT_TIMEOUT)
        except subprocess.TimeoutExpired:
            p.terminate()
            p.communicate()
            die(f"git did not finish within {GIT_TIMEOUT} s: git {' '.join(args)}")
        finally:
            Run.child = None
    if Run.terminated:
        raise SystemExit(128 + signal.SIGTERM)
    return p.returncode, out, err or b""


def git(*args: str, message: str | None = None) -> subprocess.CompletedProcess[str]:
    """git with `args` in the working directory and `message` on its stdin; its stdout and stderr
    together in `stdout`."""
    code, out, _ = run_git(args, None if message is None else os.fsencode(message), merged=True)
    return subprocess.CompletedProcess(args, code, os.fsdecode(out))


def lock_path() -> pathlib.Path:
    """The lock: beside the job's log on macOS, in the XDG state directory elsewhere."""
    home = pathlib.Path.home()
    if sys.platform == "darwin":
        return home / "Library" / "Logs" / "claude-autocommit" / "lock"
    state = os.environ.get("XDG_STATE_HOME") or str(home / ".local" / "state")
    return pathlib.Path(state) / "claude-autocommit" / "lock"


def take_lock(lock: pathlib.Path) -> bool:
    """Make the lock directory, and take over a lock older than LOCK_STALE_MIN minutes. False:
    another run holds it. mkdir is the atomic primitive, and macOS has no flock(1)."""
    try:
        lock.parent.mkdir(parents=True, exist_ok=True)
    except OSError:
        die(f"cannot create {lock.parent}")
    try:
        lock.mkdir()
    except OSError:
        try:
            age = time.time() - lock.lstat().st_mtime
        except OSError:
            return False
        if age <= LOCK_STALE_MIN * 60:
            return False
        say(f"lock older than {LOCK_STALE_MIN}m — taking it over")
        try:
            lock.rmdir()
            lock.mkdir()
        except OSError:
            return False
    return True


def settling(path: str, quiesce_min: int) -> bool:
    """Whether `path` is a regular file modified within the last `quiesce_min` minutes: it may be
    mid-sequence, a memory written but its MEMORY.md pointer not yet added."""
    try:
        st = pathlib.Path(path).lstat()
    except OSError:
        return False
    return stat.S_ISREG(st.st_mode) and time.time() - st.st_mtime < quiesce_min * 60


def parent(path: str) -> str:
    return str(pathlib.PurePosixPath(path).parent)


def classify(status: bytes, quiesce_min: int) -> tuple[list[str], int, int]:
    """The paths to commit, in git's order, the number deferred and the number of deletions, from
    the records of `git status --porcelain -z`."""
    paths: list[str] = []
    defer_dirs: set[str] = set()
    n_defer = n_del = 0
    for record in (os.fsdecode(r) for r in status.split(b"\0") if r):
        xy, path = record[:2], record[3:]
        # A rename has two records, and a renamed plan or memory is not this job's to guess about.
        if "R" in xy:
            die(f"rename under plans/ or memory/ ({path}) — commit it by hand")
        if "D" in xy:
            n_del += 1
            paths.append(path)
        elif settling(path, quiesce_min):
            n_defer += 1
            defer_dirs.add(parent(path))
        else:
            paths.append(path)
    # An index must never be committed pointing at a file this run is deferring, so if any memory
    # in a directory is still settling, that directory's MEMORY.md waits with it.
    kept: list[str] = []
    for path in paths:
        if pathlib.PurePosixPath(path).name == "MEMORY.md" and parent(path) in defer_dirs:
            say(f"deferring {path} — a memory in the same directory is still settling")
            n_defer += 1
        else:
            kept.append(path)
    return kept, n_defer, n_del


def locked_index(out: str) -> bool:
    """Whether a git command's output says that another process holds the index; it says so."""
    if any(marker in out for marker in LOCKED):
        say("index locked by another process — retrying next interval")
        return True
    return False


def changes(repo: str, quiesce_min: int) -> tuple[list[str], int, int]:
    """In the repository `repo`, which becomes the working directory: the paths to commit, the
    number deferred and the number of deletions, as `classify` gives them."""
    try:
        os.chdir(repo)
    except OSError:
        die(f"no such directory: {repo}")
    if git("rev-parse", "--git-dir").returncode != 0:
        die(f"not a git repository: {repo}")
    # An empty answer of the status below reads as "nothing to do", so first make sure that the
    # pathspec still matches a tracked file.
    tracked = git("ls-files", "--", *SPEC)
    if tracked.returncode != 0 or not tracked.stdout.strip():
        die(
            "pathspec matches no tracked file — refusing to run (git behaviour changed, or this is a "
            "fresh repository with no plans and no memories yet)"
        )
    # A failed status is *unknown*, never "nothing to commit". NUL-separated, so that a path with a
    # space or a non-ASCII name survives.
    code, out, err = run_git(("status", "--porcelain", "-z", "--", *SPEC), None, merged=False)
    if code != 0:
        die(f"git status failed (rc={code}): {os.fsdecode(err).rstrip()}")
    return classify(out, quiesce_min)


def run(*, dry: bool, no_push: bool) -> int:
    """One run: the exit status."""
    repo = setting("CLAUDE_AUTOCOMMIT_REPO", str(pathlib.Path.home() / ".claude"))
    quiesce_min = integer("CLAUDE_AUTOCOMMIT_QUIESCE_MIN", "5")
    max_deletions = integer("CLAUDE_AUTOCOMMIT_MAX_DELETIONS", "20")
    push = not no_push and integer("CLAUDE_AUTOCOMMIT_PUSH", "1") == 1
    branch = setting("CLAUDE_AUTOCOMMIT_BRANCH", "main")
    paths, n_defer, n_del = changes(repo, quiesce_min)
    if not paths:
        if dry:
            say(f"nothing to commit ({n_defer} deferred)")
        return 0
    # A mass deletion is far more likely to be a tool misbehaving than an intention.
    if n_del > max_deletions:
        die(f"{n_del} deletions under plans/ or memory/ exceeds the cap of {max_deletions} — commit by hand")
    n_plans = sum(p.startswith("plans/") for p in paths)
    n_mem = sum("/memory/" in p for p in paths)
    counts = f"{n_plans} plan(s), {n_mem} memory file(s)"
    if dry:
        say(
            f"would commit {n_plans} plan(s) and {n_mem} memory file(s); "
            f"{n_defer} deferred, {n_del} deletion(s)"
        )
        for p in paths:
            print(f"  {p}", flush=True)
        if push:
            say(f"would then: git push origin main:refs/heads/{branch}")
        return 0
    if commit(paths, counts):
        say(f"committed {counts}" + (f", {n_defer} deferred" if n_defer else ""))
        # Never --force, never rebase. A non-fast-forward is left for a human; the commit is
        # already safe locally, which is the point of the job.
        if push:
            pushed = git("push", "origin", f"main:refs/heads/{branch}")
            if pushed.returncode != 0:
                warn(
                    f"push failed (rc={pushed.returncode}), commit is local — leaving it: "
                    f"{pushed.stdout.rstrip()}"
                )
    return 0


def commit(paths: Sequence[str], counts: str) -> bool:
    """Stage `paths` by name and commit them by pathspec, with `counts` in the subject. False: a
    locked index, or nothing to commit, left for the next run."""
    for p in paths:
        added = git("add", "--", p)
        if added.returncode != 0:
            if locked_index(added.stdout):
                return False
            die(f"git add failed for {p} (rc={added.returncode}): {added.stdout.rstrip()}")
    message = (
        f"chore(auto): {counts} — {time.strftime('%Y-%m-%d %H:%M')}\n\n"
        f"Committed by claude-autocommit on {socket.gethostname().split('.')[0]}. Scope is plans/ and\n"
        "projects/*/memory/ only; everything else in ~/.claude is authored and\n"
        "committed by hand.\n\n" + "".join(f"{p}\n" for p in paths)
    )
    # The pathspec is the safety property: it commits these files' worktree content and ignores
    # whatever else is sitting staged in the index.
    committed = git("commit", "-F", "-", "--", *paths, message=message)
    if committed.returncode != 0:
        if locked_index(committed.stdout):
            return False
        if "nothing to commit" in committed.stdout or "no changes added" in committed.stdout:
            return False
        die(f"git commit failed (rc={committed.returncode}): {committed.stdout.rstrip()}")
    return True


def terminated(signum: int, _frame: FrameType | None) -> None:
    """A SIGTERM goes on to the running git. The run ends through SystemExit when that git, or the
    next git where none runs, has ended, so that the lock goes with it; a SIGTERM after the last
    git lets the run finish."""
    Run.terminated = True
    if Run.child is not None:
        Run.child.send_signal(signum)


def main(argv: Sequence[str]) -> int:
    # A path whose name is not UTF-8 is printed as its bytes, in every locale.
    for stream in (sys.stdout, sys.stderr):
        if isinstance(stream, io.TextIOWrapper):
            stream.reconfigure(errors="surrogateescape")
    dry = no_push = False
    for arg in argv:
        if arg == "--dry-run":
            dry = True
        elif arg == "--no-push":
            no_push = True
        elif arg in ("-h", "--help"):
            print(USAGE, end="")
            return 0
        else:
            print(f"unknown argument: {arg}\n{USAGE}", end="", file=sys.stderr)
            return 1
    # launchd will not start a second copy while this one runs, but a hand invocation can. The dry
    # run takes no lock.
    lock = None if dry else lock_path()
    if lock is not None:
        if not take_lock(lock):
            return 0  # another run has it; the next interval picks this up
        signal.signal(signal.SIGTERM, terminated)
    try:
        return run(dry=dry, no_push=no_push)
    finally:
        if lock is not None:
            with contextlib.suppress(OSError):
                lock.rmdir()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
