#!/usr/bin/env bash
#
# The pre-push hook of the harness repository. Enable it once per checkout:
#
#   git config core.hooksPath .githooks
#
# It tests the pushed commit, never the working tree: a `git clone --shared` of this repository in
# a temporary directory under $TMPDIR, at the pushed SHA, removed on exit. A push of any ref other
# than main gets `harness leaks --commits` only, over the tree at its SHA and the commits that the
# push sends (remote..local, or the commits that origin/main lacks for a new branch), so a PR
# branch cannot bring a private string to main; its gitleaks checks and its suite run in CI. A
# hit, no python3 of 3.14 or later, or a check that fails refuses the push with one line.
#
# A push to main gets the full gate. First the leak checks: gitleaks over the commits
# that the push sends, gitleaks stdin over their messages, which gitleaks git does not read,
# gitleaks over the tree at the SHA, and `harness leaks --commits` over both, messages included.
# They fail closed: no gitleaks of 8.21 or later, no profile, an empty `leak` list or a check that
# fails each refuse the push with one line. Then it runs `bin/harness test` once, which runs on
# the interpreter of the harness's Python environment, the compile check on that interpreter,
# the strict profile (`ruff format --check`, `ruff check` and `basedpyright`, from the
# environment's bin/, where the profile's `develop = true` puts them; a tool that it lacks refuses
# the push), then shellcheck over the shell files, the kit's tests
# examples/dotfiles/tests/{update-check,check-check,driver-check,render-check,script-check}.py on
# python3, and the Julia test files that the changed paths of the pushed range select.
# A missing tool among shellcheck, chezmoi and julia prints one skip line, because CI runs them;
# no python3 of 3.14 or later refuses the push.

# No `set -u`: macOS ships bash 3.2, whose handling of unset expansions differs from bash 4+.
set -o pipefail

root=$(git rev-parse --show-toplevel) || exit 1
# A hook inherits git's variables, and they would point the git commands in the clone back here.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES

# git feeds "<local ref> <local sha> <remote ref> <remote sha>" on stdin, one line per ref.
sha=
old=
branches=()
while read -r _local_ref local_sha remote_ref remote_sha; do
    case "$local_sha" in
        *[!0]*) ;;
        *) continue ;; # a deleted ref: nothing to test
    esac
    if [ "$remote_ref" = refs/heads/main ]; then
        sha=$local_sha
        old=$remote_sha
    else
        branches+=("$remote_ref $local_sha $remote_sha")
    fi
done
if [ -z "$sha" ] && [ "${#branches[@]}" -eq 0 ]; then
    echo "pre-push: no commit pushed, nothing to test"
    exit 0
fi

refuse() {
    echo "pre-push: refused, $1"
    exit 1
}

tmp=$(mktemp -d "${TMPDIR:-/tmp}/harness-pre-push.XXXXXX") || exit 1
trap 'rm -rf "$tmp"' EXIT

# Each check that finds a leak (exit 1) or fails (any other exit) prints its output and refuses the
# push with one line; every check runs, so the output names every check that refuses.
leaks=0
leak_check() {
    local name=$1 status
    shift
    echo "$name"
    "$@" >"$tmp/leaks.log" 2>&1
    status=$?
    case "$status" in
        0) tail -n 1 "$tmp/leaks.log" ;;
        1) cat "$tmp/leaks.log"; echo "pre-push: refused, $name found a leak"; leaks=1 ;;
        *) cat "$tmp/leaks.log"; echo "pre-push: refused, $name failed with exit $status"; leaks=1 ;;
    esac
}

# bin/harness starts on python3, which must be 3.14 or later, and runs each command on the
# interpreter of the Python environment.
find_python() {
    python=python3
    command -v "$python" >/dev/null &&
        "$python" -c 'import sys; sys.exit(sys.version_info < (3, 14))' 2>/dev/null ||
        refuse "no python3 of 3.14 or later"
}

# A branch gets `harness leaks` only; gitleaks and the suite run in CI. The commits that the push
# sends are remote..local, or, for a new branch or a remote SHA that the checkout lacks, the
# commits that origin/main does not hold, the whole history without one.
if [ "${#branches[@]}" -gt 0 ]; then
    find_python
    origin_url=$(git remote get-url origin) || refuse "the checkout has no origin remote"
    n=0
    for entry in "${branches[@]}"; do
        read -r ref local_sha remote_sha <<<"$entry"
        n=$((n + 1))
        exclude=
        case "$remote_sha" in
            *[!0]*) git cat-file -e "$remote_sha^{commit}" 2>/dev/null && exclude=$remote_sha ;;
        esac
        if [ -z "$exclude" ] && git rev-parse -q --verify refs/remotes/origin/main >/dev/null; then
            exclude=refs/remotes/origin/main
        fi
        if [ -n "$exclude" ]; then
            git rev-list "$local_sha" --not "$exclude" >"$tmp/branch-$n.commits"
        else
            git rev-list "$local_sha" >"$tmp/branch-$n.commits"
        fi || refuse "git rev-list of the commits pushed to $ref failed"
        git clone --shared --quiet --no-checkout "$root" "$tmp/branch-$n" || exit 1
        cd "$tmp/branch-$n" || exit 1
        git checkout --quiet --detach "$local_sha" || exit 1
        # The clone's origin is the checkout; `harness leaks` allows the owner/name of the real one.
        git remote set-url origin "$origin_url" || exit 1
        leak_check "harness leaks, the tree at $(git rev-parse --short HEAD) and the commits that the push sends to $ref" \
            "$python" bin/harness leaks --commits "$tmp/branch-$n.commits"
        cd "$root" || exit 1
    done
    [ "$leaks" -eq 0 ] || exit 1
fi
if [ -z "$sha" ]; then
    echo "pre-push: no commit pushed to main; the leak check of the branches passed"
    exit 0
fi

# gitleaks 8.19 added the `git`, `dir` and `stdin` commands; 8.21 is the first with
# `[[rules.allowlists]]`, which `.gitleaks.toml` uses.
command -v gitleaks >/dev/null || refuse "no gitleaks on PATH; install gitleaks 8.21 or later"
gitleaks_version=$(gitleaks version 2>/dev/null)
version_pattern='^v?([0-9]+)\.([0-9]+)\.[0-9]+'
[[ $gitleaks_version =~ $version_pattern ]] ||
    refuse "cannot read the gitleaks version from '$gitleaks_version'; gitleaks 8.21 or later is needed"
major=${BASH_REMATCH[1]}
minor=${BASH_REMATCH[2]}
if [ "$major" -lt 8 ] || { [ "$major" -eq 8 ] && [ "$minor" -lt 21 ]; }; then
    refuse "gitleaks $gitleaks_version is older than 8.21"
fi
find_python

# The commits that the push brings to main: old..sha, as CI scans them. A commit that a branch of
# origin already holds is scanned too, because main has not seen it. A forced push sends the
# rewritten commits, and a new main, or an old main that the checkout lacks, the whole history.
origin_url=$(git remote get-url origin) || refuse "the checkout has no origin remote"
range=$sha
case "$old" in
    *[!0]*) git cat-file -e "$old^{commit}" 2>/dev/null && range="$old..$sha" ;;
esac
git rev-list "$range" >"$tmp/commits" || refuse "git rev-list of the pushed commits failed"
git clone --shared --quiet --no-checkout "$root" "$tmp/repo" || exit 1
cd "$tmp/repo" || exit 1
git checkout --quiet --detach "$sha" || exit 1
echo "pre-push: testing $(git rev-parse --short HEAD) for main, in a clone under $tmp"

# The leak checks, before the suite, so a refused push costs seconds; all four run.
# The config of the pushed commit; a `gitleaks:allow` comment has no effect.
gitleaks_flags=(--config "$tmp/repo/.gitleaks.toml" --redact --ignore-gitleaks-allow --no-banner --no-color --verbose)
leak_check "gitleaks git, the commits that the push brings to main" \
    gitleaks git "${gitleaks_flags[@]}" --log-opts="$range" "$root"
# gitleaks git reads no commit message, so the messages go to gitleaks stdin, read in the checkout.
# No commit to send is empty input, which passes; without the test, git log would read HEAD.
messages() (
    cd "$root" || exit 2
    if [ -s "$tmp/commits" ]; then
        git log --no-walk --no-show-signature --format=%B --stdin <"$tmp/commits"
    fi | gitleaks stdin "${gitleaks_flags[@]}"
)
leak_check "gitleaks stdin, the messages of the commits that the push sends" messages
leak_check "gitleaks dir, the tree at the SHA" gitleaks dir "${gitleaks_flags[@]}" "$tmp/repo"
# The clone's origin is the checkout; `harness leaks` allows the owner/name of the real one.
git remote set-url origin "$origin_url" || exit 1
leak_check "harness leaks, the tree at the SHA and the commits that the push sends" \
    "$python" bin/harness leaks --commits "$tmp/commits"
[ "$leaks" -eq 0 ] || exit 1

# The changed paths of the range. A new main, or a remote SHA that this clone does not have,
# starts at the empty tree.
base=$old
case "$old" in
    *[!0]*) git cat-file -e "$old^{commit}" 2>/dev/null || base= ;;
    *) base= ;;
esac
[ -n "$base" ] || base=$(git hash-object -t tree /dev/null)
# --no-renames: a renamed file lists its old path too, so a moved source still selects its test.
changed=$(git diff --name-only --no-renames "$base" HEAD) || exit 1

fail=0

# The Python steps: the suite once, which bin/harness runs on the environment's interpreter, then
# the compile check on that interpreter, at the path that bin/harness's own `interpreter` and
# `environment_path` give, and the three checks of the strict profile.
echo "$python bin/harness test"
if "$python" bin/harness test >"$tmp/test.log" 2>&1; then
    tail -n 1 "$tmp/test.log"
else
    # Each wrong case with the lines that follow it up to the next case or the summary: a
    # case can span several lines, and the BAD line of a crashed probe is followed by its
    # traceback. The lines of a passing case are left out.
    awk '/^BAD/ { p = 1 } /^ok / || /^[0-9]+ cases, [0-9]+ wrong$/ { p = 0 } p' "$tmp/test.log"
    last=$(tail -n 1 "$tmp/test.log")
    case "$last" in
        *" cases, "*" wrong") echo "$last" ;;
        *) tail -n 20 "$tmp/test.log" ;; # no summary line: a crash, and its traceback ends the log
    esac
    fail=1
fi
environment_python=$("$python" -c '
import sys
boot = {"__name__": "harness_boot", "__file__": sys.argv[1]}
exec(compile(open(sys.argv[1]).read(), sys.argv[1], "exec"), boot)
print(boot["interpreter"](boot["environment_path"]()))
' bin/harness)
if [ -n "$environment_python" ]; then
    echo "$environment_python -m compileall -q lib hooks scripts adapters"
    "$environment_python" -m compileall -q lib hooks scripts adapters || fail=1
    # The strict profile, with the tools of the environment's bin/, never of the PATH. All three
    # checks run; a tool that the environment lacks refuses the push and runs none.
    tools=${environment_python%/*}
    lacking=
    for tool in ruff basedpyright; do
        if [ ! -f "$tools/$tool" ]; then
            echo "pre-push: no $tool in $tools; set develop = true in the profile, then run harness install --apply"
            lacking=1
        fi
    done
    if [ -n "$lacking" ]; then
        fail=1
    else
        echo "$tools/ruff format --check --no-cache ."
        "$tools/ruff" format --check --no-cache . || fail=1
        echo "$tools/ruff check --no-cache ."
        "$tools/ruff" check --no-cache . || fail=1
        echo "$tools/basedpyright"
        "$tools/basedpyright" || fail=1
    fi
else
    echo "pre-push: bin/harness names no interpreter of the Python environment"
    fail=1
fi

# The lint of every tracked file with a sh or bash shebang.
if command -v shellcheck >/dev/null; then
    shell_files=()
    while IFS= read -r f; do
        head -n 1 "$f" | grep -qE '^#!(/usr)?/bin/(env )?(ba)?sh' && shell_files+=("$f")
    done < <(git ls-files)
    echo "shellcheck -S warning ${shell_files[*]}"
    shellcheck -S warning "${shell_files[@]}" || fail=1
else
    echo "skip  shellcheck: not found; CI runs it"
fi

if [ "$fail" -ne 0 ]; then
    echo "pre-push: refused; fix the commit, because the hook tests the commit and not the working tree"
    exit 1
fi

# The kit's tests need chezmoi; CI runs them in the job `dotfiles`. All five run, and each that
# fails prints the end of its output.
if command -v chezmoi >/dev/null; then
    kit_failed=
    for kit_test in update-check check-check driver-check render-check script-check; do
        file=examples/dotfiles/tests/$kit_test.py
        echo "$python $file"
        if "$python" "$file" >"$tmp/$kit_test.log" 2>&1; then
            tail -n 1 "$tmp/$kit_test.log"
        else
            tail -n 20 "$tmp/$kit_test.log"
            kit_failed="$kit_failed $file"
        fi
    done
    [ -z "$kit_failed" ] || refuse "the kit's tests failed:$kit_failed"
else
    echo "skip  chezmoi: not found; CI runs the kit's tests"
fi

# The Julia selection: the test files that the changed paths select.
all="scripts/gate-test.jl scripts/mutants-test.jl scripts/run-tests-test.jl scripts/test-layout-test.jl githooks/release-notes-test.jl scripts/julia-update-test.jl launchagents/claude-autocommit-test.jl githooks/pre-commit-test.jl scripts/fatou-lsp-test.jl scripts/base-tree-test.jl"
selection=
select_test() {
    case " $selection " in
        *" $1 "*) ;;
        *) selection="$selection $1" ;;
    esac
}
while IFS= read -r path; do
    case "$path" in
        scripts/gate.jl) select_test scripts/gate-test.jl ;;
        scripts/mutants.jl) select_test scripts/mutants-test.jl ;;
        scripts/run-tests.jl | scripts/mutate.jl | scripts/mutate-worker.jl | scripts/test-census.jl | scripts/pins.jl)
            select_test scripts/run-tests-test.jl ;;
        scripts/test-layout.jl) select_test scripts/test-layout-test.jl ;;
        githooks/release-notes.jl) select_test githooks/release-notes-test.jl ;;
        scripts/julia-update.jl) select_test scripts/julia-update-test.jl ;;
        launchagents/claude-autocommit) select_test launchagents/claude-autocommit-test.jl ;;
        githooks/pre-commit | githooks/pre-commit.jl) select_test githooks/pre-commit-test.jl ;;
        githooks/pre-push | githooks/pre-push.jl) select_test githooks/pre-commit-test.jl ;;
        scripts/fatou-lsp.jl) select_test scripts/fatou-lsp-test.jl ;;
        scripts/base-tree.jl) select_test scripts/base-tree-test.jl ;;
        *-test.jl) [ -f "$path" ] && select_test "$path" ;; # a deleted test file selects nothing
        Project.toml) for f in $all; do select_test "$f"; done ;;
        *.jl) echo "Julia: $path selects no test file" ;;
    esac
done <<<"$changed"

# The time of each file on the author's machine: run-tests-test.jl is silent for 11 minutes.
duration() {
    case "$1" in
        scripts/gate-test.jl | scripts/mutants-test.jl) echo "about 5 s" ;;
        githooks/release-notes-test.jl) echo "about 4 s" ;;
        launchagents/claude-autocommit-test.jl) echo "about 2 s" ;;
        githooks/pre-commit-test.jl) echo "about 1 min" ;;
        scripts/base-tree-test.jl) echo "about 3 s" ;;
        scripts/fatou-lsp-test.jl) echo "about 7 s" ;;
        scripts/julia-update-test.jl) echo "about 14 s" ;;
        scripts/test-layout-test.jl) echo "about 2 min" ;;
        scripts/run-tests-test.jl) echo "about 11 min, silent" ;;
        *) echo "time not measured" ;;
    esac
}
if [ -n "$selection" ]; then
    echo "Julia selection:$selection"
    if ! command -v julia >/dev/null; then
        echo "skip  julia: not found; CI runs the Julia tests"
    else
        for f in $selection; do
            echo "julia $f ($(duration "$f"))"
            julia --startup-file=no "$f" || { fail=1; break; }
        done
    fi
fi

if [ "$fail" -ne 0 ]; then
    echo "pre-push: refused; a Julia test failed"
    exit 1
fi
echo "pre-push: passed"
exit 0
