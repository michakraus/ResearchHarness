# The daily update of Julia and the Kaimon server, the Linux twin of
# launchagents/julia-update.plist. julia-update.timer starts it; it has no [Install] section of
# its own. Its output goes to the journal: `journalctl --user -u julia-update.service`.

[Unit]
Description=Update Julia and the Kaimon server

[Service]
Type=oneshot
# The juliaup launcher, not a release path, and the installed copy of the script, which a session
# cannot write: ~/.local/bin is deny-write for a session. ExecStart runs the update phase under
# bwrap through jobbox, with the arguments of ~/.config/research-harness/sandbox/julia-update.bwrap;
# ExecStopPost runs the server phase outside it, after the update phase, whether that failed or
# not: the server check, the restart and the alerts need the server's process, the service
# manager and the session bus, which the update phase does not see. The server phase is the
# installed copy of scripts/julia-update-server, a POSIX sh script that runs no Julia and no
# program of a directory below the home, which the jobs write.
ExecStart={home}/.local/bin/jobbox julia-update {home}/.juliaup/bin/julia --startup-file=no {home}/.local/bin/julia-update.jl
ExecStopPost={home}/.local/bin/julia-update-server
# Deprioritised: a Pkg resolve that competes with an interactive Julia session is worse than a
# late one.
Nice=5
IOSchedulingClass=idle
# JULIA_PKG_USE_CLI_GIT is load-bearing: libgit2 fails behind an authenticating proxy. PATH is for
# the git that setting then calls, and holds no directory a session can write.
Environment=JULIA_PKG_USE_CLI_GIT=true
Environment=PATH={home}/.juliaup/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin
