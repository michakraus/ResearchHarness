      "glab api * -f *": "ask",
      "glab api * -F *": "ask",
      "git tag -d *": "ask",
      "git tag --delete *": "ask",
      "git tag -f *": "ask",
      "git tag --force *": "ask",
      "git tag * -d": "ask",
      "git tag * --delete": "ask",
      "git tag * -f": "ask",
      "git tag * --force": "ask",
      "git merge --no-ff*": "ask",
      "git merge * --no-ff*": "ask",
