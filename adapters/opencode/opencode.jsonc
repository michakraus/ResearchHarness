      "glab release upload *": "ask",
      "glab repo create *": "ask",
      "glab repo edit *": "ask",
      "glab repo rename *": "ask",
      "glab repo fork *": "ask",
      "glab repo sync *": "ask",
      "glab api graphql *": "ask",
