{
  "$schema": "https://opencode.ai/config.json",

  "plugin": ["opencode-anthropic-login-via-cli@latest"],

  // Option A, the default: the hosted model is primary. Option B is the `local` agent,
  // reached with `opencode --agent local`. See agents/ and README.md.
  "model": "opencode-go/deepseek-v4.1-flash",

  // Background work (session titles and similar) goes to the local model. It then costs
  // nothing, and it continues to operate without a network.
  "small_model": "local-mlx/mlx-community/Qwen3.8-27B-8bit",

  // OpenCode's global instruction file is AGENTS.md in its configuration directory, which
  // `harness install` writes from OPENCODE-DELTA.md: the facts of this harness. It takes the place
  // of ~/.claude/CLAUDE.md, the Claude Code mechanics, which OpenCode reads only when no AGENTS.md
  // exists there.
  //
  // RTK.md, instructions/core.md and instructions/research-tree.md are listed because OpenCode
  // does not follow a file reference in an instruction file (opencode.ai/docs/rules). Without these
  // entries the core rules, the tree instructions and the RTK facts — the `head`/`tail` exclusion,
  // the per-file cap of `rtk grep` — never reach a session, while plugins/rtk.ts still rewrites its
  // commands. CLAUDE.md imports the same three under Claude Code, so the cost is the same in both
  // harnesses.
  //
  // KEEP THE DELTA SMALL. The global file and the `instructions` files load EAGERLY into every
  // session, unlike a directory-scoped CLAUDE.md, which loads only when a file in its subtree is
  // read. The delta's budget is 5 KB, 5,120 bytes. Anything longer belongs in a lazily-loaded file
  // that it points at.
  // This is also why the project-memory entries are NOT listed here: they are ~120,000 tokens
  // before the first message. See Tasks/Migrate the Claude Code project memory.md.
  "instructions": [
    "~/.claude/RTK.md",
    "~/.claude/instructions/core.md",
    "~/.claude/instructions/research-tree.md"
  ],

  // The providers come from the private profile (`opencode_providers`): their hosts, servers
  // and accounts name the user's institution and machines.
  "provider": {
{opencode_providers}
  },

  "mcp": {
    // codebase-memory-mcp was here until 2026-09-16. It was rejected on measurement —
    // Environment/Notes/Helpers-and-MCPs.md, "What was rejected" — and removing it returns
    // 5,816 tokens, 9% of the 64k window. Do not add it back.

    // Kaimon is a persistent HTTP server on 127.0.0.1:2828, started by the LaunchAgent
    // launchagents/kaimon.plist. It is NOT a subprocess, thus the type is "remote".
    // Do not change this to "local": OpenCode would start a second server, and the
    // second server cannot bind the port.
    //
    // The URL is verified: a GET on the root path with a correct credential returns
    // 200 text/event-stream. A wrong credential returns 401 on every path.
    //
    // THE TOKEN IS NOT IN THIS FILE. This file is under version control, thus it must
    // contain no secret. Put the token alone in ~/.config/kaimon/opencode-token, with
    // mode 600. OpenCode substitutes {file:...} when it reads the configuration.
    "kaimon": {
      "type": "remote",
      "url": "http://127.0.0.1:2828/",
      "headers": { "Authorization": "Bearer {file:~/.config/kaimon/opencode-token}" },
      "enabled": true
    }
  },

  // Every agent is defined in agents/<name>.md, frontmatter and body together. There is no
  // `agent` block here any more, and that is deliberate.
  //
  // `agent` IS a top-level key, beside `mcp` and `provider` — put it inside `mcp` and the
  // validator reads it as a server definition and reports "Missing key mcp.agent.enabled".
  // It is simply not needed: the gate that used to live here now lives in each agent's own
  // frontmatter, so one file carries one agent.
  //
  // WHY THE GATE MOVED, measured 2026-09-18 with `opencode run` on claude-haiku-4-5, reading
  // tokens.cache.write from ~/.local/share/opencode/opencode.db:
  //
  //     baseline                              31,025 prompt tokens
  //     permission: { "kaimon_*": "deny" }     20,102   (-10,923)
  //     tools:      { "kaimon*":  false  }     cache READ of 20,099 — identical prefix
  //
  // The two produce a byte-identical prompt, so `permission` alone drops the tool schemas.
  // `tools` is marked @deprecated in the schema and was merged into `permission` in v1.1.1.
  // Since it buys nothing, it is gone. Do not reintroduce it.
  //
  // MCP tools are named <server>_<tool>, thus `kaimon_ex`, and `kaimon_*` matches them all.

  // Generated by `harness permissions` from ../settings/settings.proposal.json. DO NOT EDIT
  // BY HAND — re-run it, which round-trips every rule and reports what it dropped.
  //
  // READ THIS BEFORE TRUSTING IT: OpenCode has NO SANDBOX. Claude Code's deny list sits
  // behind a filesystem and network allowlist and is accident-prevention. Here it is the
  // ONLY control, and ~/.claude/CLAUDE.md itself records that deny patterns are escapable
  // by any command carried inside a string argument. See OPENCODE-DELTA.md.
  //
  // Ordering matters and is not cosmetic: OpenCode takes the LAST matching rule, so `ask`
  // is emitted before `deny`. Claude resolves by category instead and ignores order.
  // The `allow` rules are deliberately not ported.

  "permission": {
    "read": {
      "{home}/.ssh/**": "deny",
      "{home}/.aws/**": "deny",
      "{home}/.gnupg/**": "deny",
      "{home}/.netrc": "deny",
      "{home}/.claude.json": "deny",
      "{home}/.claude/backups/**": "deny",
      "{home}/.config/kaimon/config.json": "deny",
      "{home}/.config/kaimon/opencode-token": "deny",
      "{home}/.config/api-keys/**": "deny",
      "{home}/.config/chezmoi/**": "deny",
      "{home}/.config/gh/hosts.yml": "deny",
      "{home}/.claude/.credentials.json": "deny",
      "{home}/.omp/agent/.env": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/secrets/**": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/id_rsa*": "deny",
      "**/id_ed25519*": "deny",
      "{home}/.local/share/opencode/**": "deny"
    },
    "edit": {
      "{home}/Research/**/.githooks/**": "ask",
      "{home}/Research/**/.github/workflows/**": "ask",
      "{home}/.claude/skills/**": "ask",
      "{home}/.claude/workflows/**": "ask",
      "{home}/.claude/hooks/**": "deny",
      "{home}/.claude/CLAUDE.md": "deny",
      "{home}/.claude/RTK.md": "deny",
      "{home}/.claude/statusline-command.sh": "deny",
      "{home}/.claude/.harness-install.json": "deny",
      "{home}/.claude/agents/**": "deny",
      "{home}/.claude/commands/**": "deny",
      "{home}/.claude/instructions/**": "deny",
      "{home}/.claude/rules/**": "deny",
      "{home}/.claude/skills/build-part/**": "deny",
      "{home}/.claude/skills/build-reviewed/**": "deny",
      "{home}/.claude/skills/julia-package-audit/**": "deny",
      "{home}/.claude/skills/julia-performance/**": "deny",
      "{home}/.claude/skills/julia-release/**": "deny",
      "{home}/.claude/skills/julia-structure/**": "deny",
      "{home}/.claude/skills/julia-surgical-fix/**": "deny",
      "{home}/.claude/skills/latex-revision/**": "deny",
      "{home}/.claude/skills/math-verify/**": "deny",
      "{home}/.claude/skills/plan-parts/**": "deny",
      "{home}/.claude/skills/wait-what/**": "deny",
      "{home}/.claude/skills/which-model/**": "deny",
      "{home}/.claude/settings.json": "deny",
      "{home}/.claude/settings.local.json": "deny",
      "{home}/.claude.json": "deny",
      "**/.claude/settings.json": "deny",
      "**/.claude/settings.local.json": "deny",
      "**/.mcp.json": "deny",
      "**/.git/**": "deny",
      "{home}/{protected_dir}/**/.githooks/**": "deny",
      "{home}/.zshrc": "deny",
      "{home}/.zprofile": "deny",
      "{home}/.zshenv": "deny",
      "{home}/.bashrc": "deny",
      "{home}/.bash_profile": "deny",
      "{home}/.gitconfig": "deny",
      "{home}/.config/**": "deny",
      "{home}/.local/bin/**": "deny",
      "{home}/.local/share/chezmoi/**": "deny",
      "{home}/.julia/juliaup/julia-*/**": "deny",
      "{home}/.julia/juliaup/juliaup.json": "deny",
      "{home}/.julia/juliaup/versiondb-*": "deny",
      "{home}/.julia/bin/**": "deny",
      "{home}/.julia/environments/apps/**": "deny",
      "{home}/.julia/config/**": "deny",
      "{home}/Library/LaunchAgents/**": "deny",
      "{home}/{protected_dir}/**": "deny",
      "{harness}/adapters/opencode/**": "ask",
      "{home}/.claude/rules/**": "ask",
      "{home}/.julia/packages/**": "deny"
    },
    "external_directory": {
      "{home}/.julia/packages/*": "allow",
      "{home}/Research/*": "allow",
      "{home}/.claude/rules/*": "allow",
      "{home}/.claude/skills/*": "allow",
      "{home}/.claude/agents/*": "allow",
      "{home}/.config/opencode/*": "allow",
      "/tmp/*": "allow"
    },
    "kaimon_debug_ctrl": "ask",
    "kaimon_debug_eval": "ask",
    "kaimon_debug_exfiltrate": "ask",
    "kaimon_debug_safehouse": "ask",
    "kaimon_manage_extension": "ask",
