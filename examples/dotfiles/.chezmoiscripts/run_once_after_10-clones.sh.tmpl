{{- /* No shebang on the first line of the template, so that a shellcheck of the files with a
       shell shebang skips it: tests/script-check.py checks the render. */ -}}
#!/bin/bash
# The clones: ~/.claude, ~/Research/Environment, ~/Research/Harness and the meta repository
# (~/Research/.meta/.git, whose work tree is ~/Research), from the remotes of the [remotes] table
# of .chezmoidata/machines.toml. Each is skipped when its directory is already a clone of the
# expected remote. When the directory exists and is not one, the script stops with a message
# before the first clone and changes nothing. chezmoi runs this script once; a failed run runs
# again.
set -eu

CLAUDE_URL={{ .remotes.claude | shellQuote }}
ENVIRONMENT_URL={{ .remotes.environment | shellQuote }}
HARNESS_URL={{ .remotes.harness | shellQuote }}
META_URL={{ .remotes.meta | shellQuote }}
META="$HOME/Research/.meta"

# is_clone DIR URL: DIR holds its own .git, and its origin is URL.
is_clone() {
    [ -e "$1/.git" ] || return 1
    [ "$(git --git-dir="$1/.git" config --get remote.origin.url || true)" = "$2" ]
}

# refuse DIR URL: stop when DIR exists and is not a clone of URL.
refuse() {
    if ! is_clone "$1" "$2" && { [ -e "$1" ] || [ -L "$1" ]; }; then
        echo "chezmoi: $1 exists and is not a clone of $2." >&2
        echo "chezmoi: move it away, then run chezmoi apply again." >&2
        exit 1
    fi
}

# clone DIR URL [git clone options]: clone URL into DIR unless DIR is a clone of it already.
clone() {
    dir=$1
    url=$2
    shift 2
    if is_clone "$dir" "$url"; then
        echo "chezmoi: $dir is a clone of $url already; skipped."
        return 0
    fi
    mkdir -p "$(dirname "$dir")"
    git clone "$@" "$url" "$dir"
}

refuse "$HOME/.claude" "$CLAUDE_URL"
refuse "$HOME/Research/Environment" "$ENVIRONMENT_URL"
refuse "$HOME/Research/Harness" "$HARNESS_URL"
refuse "$META" "$META_URL"

clone "$HOME/.claude" "$CLAUDE_URL"
clone "$HOME/Research/Environment" "$ENVIRONMENT_URL"
clone "$HOME/Research/Harness" "$HARNESS_URL"

# The meta repository tracks the directory-scoped CLAUDE.md files and .kaimon/tools.json in
# ~/Research itself, so its clone has no checkout of its own.
if ! is_clone "$META" "$META_URL"; then
    clone "$META" "$META_URL" --no-checkout
    git --git-dir="$META/.git" config core.worktree "$HOME/Research"
fi
# Fill the work tree while the index is empty: after the clone, or after a run that stopped
# here. `read-tree -m -u` refuses to overwrite a file that is in ~/Research already.
cd "$HOME/Research"
if [ -z "$(git --git-dir="$META/.git" ls-files)" ]; then
    git --git-dir="$META/.git" read-tree -m -u HEAD
fi
