{{- /* No shebang on the first line of the template, so that a shellcheck of the files with a
       shell shebang skips it: tests/script-check.py checks the render. */ -}}
#!/bin/bash
# The harness at its pin, then `harness install --apply`. chezmoi runs this script again when the
# pin in .chezmoidata/machines.toml changes, so a machine moves to a new harness only through a
# reviewed change of that line.
#
# On the template host, ~/Research/Harness is the development checkout on main: the script moves
# no checkout there, and stops when HEAD does not contain the pin. Every other host fetches, stops
# when the checkout has local changes, and checks out the pin.
#
#   harness_commit  {{ .harness_commit }}
#   template host   {{ eq .chezmoi.hostname .template_host }}
set -eu

PIN="{{ .harness_commit }}"
HARNESS="$HOME/Research/Harness"

cd "$HARNESS"
{{- if eq .chezmoi.hostname .template_host }}

if ! git merge-base --is-ancestor "$PIN" HEAD; then
    echo "chezmoi: HEAD of $HARNESS does not contain the pin $PIN; nothing is installed." >&2
    echo "chezmoi: bring the checkout up to the pin, then run chezmoi apply again." >&2
    exit 1
fi
{{- else }}

git fetch origin

# Untracked files count as local changes too: the checkout must not run over any work.
changes=$(git status --porcelain)
if [ -n "$changes" ]; then
    echo "chezmoi: $HARNESS has local changes; the pin $PIN is not checked out:" >&2
    echo "$changes" >&2
    echo "chezmoi: commit or remove them, then run chezmoi apply again." >&2
    exit 1
fi

git -c advice.detachedHead=false checkout --detach "$PIN"
{{- end }}
"$HARNESS/bin/harness" install --apply
