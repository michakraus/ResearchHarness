{{- $host := includeTemplate "host" . | fromJson -}}
#!/bin/bash
# The services: the copies of julia-update.jl and claude-autocommit in ~/.local/bin, then the
# launch agents (macOS) or the systemd --user units (Linux), rendered by `harness render` from the
# harness at its pin and the profile. On macOS the Kaimon and julia-update jobs run under a
# Seatbelt profile, which is rendered into ~/.config/research-harness/sandbox/ before the plist,
# and the `ps` shim of the Kaimon job goes into its shims/ before that. On both systems
# ~/.cache/kaimon/pocl, the directory of Kaimon's POCL_CACHE_DIR, is made before the first load.
#
# chezmoi runs this script again when one of the inputs of the rendered units or plists changes:
#   harness_commit  {{ .harness_commit }}
#   profile         {{ includeTemplate "dot_config/research-harness/profile.toml.tmpl" . | sha256sum }}
#   os              {{ $host.os }}
set -eu

HARNESS="$HOME/Research/Harness"
harness() { "$HARNESS/bin/harness" "$@"; }

# render TEMPLATE TARGET: write the rendered template to TARGET, whole or not at all.
render() {
    harness render "$HARNESS/$1" > "$2.new"
    mv "$2.new" "$2"
}

# The jobs run the installed copies, never the checkout, which a session can write.
mkdir -p "$HOME/.local/bin"
install -m 755 "$HARNESS/launchagents/claude-autocommit" "$HOME/.local/bin/claude-autocommit"
install -m 644 "$HARNESS/scripts/julia-update.jl" "$HOME/.local/bin/julia-update.jl"

# The PoCL kernel cache of Kaimon's sessions, which POCL_CACHE_DIR of its plist and unit names,
# made before the job is loaded, as `harness setup` makes it. Each directory that mkdir creates
# has mode 700; one that exists stays as it is.
(umask 077 && mkdir -p "$HOME/.cache/kaimon/pocl")
{{- if eq $host.os "darwin" }}

prefix=$(harness get launchd_prefix)
domain="gui/$(id -u)"
agents="$HOME/Library/LaunchAgents"
mkdir -p "$agents"

# load LABEL PLIST: boot the job out when launchd has it, then bootstrap it from PLIST.
# bootout returns before launchd has removed the job, and a bootstrap in that window fails and
# leaves the job unloaded: wait up to 10 s for `launchctl print` to fail, and try a failed
# bootstrap once more after 1 s.
load() {
    if launchctl print "$domain/$1" >/dev/null 2>&1; then
        launchctl bootout "$domain/$1"
        tries=0
        while launchctl print "$domain/$1" >/dev/null 2>&1 && [ "$tries" -lt 100 ]; do
            sleep 0.1
            tries=$((tries + 1))
        done
    fi
    if ! message=$(launchctl bootstrap "$domain" "$2" 2>&1); then
        sleep 1
        if ! message=$(launchctl bootstrap "$domain" "$2" 2>&1); then
            echo "chezmoi: launchctl bootstrap of $1 failed: $message" >&2
            exit 1
        fi
    fi
}

sandbox="$HOME/.config/research-harness/sandbox"
mkdir -p "$sandbox/shims"
for job in kaimon julia-update claude-autocommit; do
    mkdir -p "$HOME/Library/Logs/$job"
    # The plist starts the job under its profile, so the profile is in place before the plist; so
    # is the `ps` of the directory that kaimon's plist puts first on its PATH.
    case "$job" in
        kaimon)
            install -m 755 "$HARNESS/sandbox/shims/ps" "$sandbox/shims/ps"
            render "sandbox/$job.sb" "$sandbox/$job.sb"
            ;;
        julia-update) render "sandbox/$job.sb" "$sandbox/$job.sb" ;;
    esac
    render "launchagents/$job.plist" "$agents/$prefix.$job.plist"
    load "$prefix.$job" "$agents/$prefix.$job.plist"
done
{{- else }}

# The Kaimon and julia-update units start their program through jobbox under bwrap, so bwrap must
# make a sandbox first, as `harness doctor` checks it; without one the script stops here and no
# job changes.
if ! bwrap --ro-bind / / --dev /dev --unshare-user --unshare-pid true; then
    echo "chezmoi: bwrap cannot make a sandbox, so no job starts under it: where AppArmor refuses" \
        "user namespaces, set kernel.apparmor_restrict_unprivileged_userns=0 or give bwrap an" \
        "AppArmor profile" >&2
    exit 2
fi
install -m 755 "$HARNESS/sandbox/jobbox" "$HOME/.local/bin/jobbox"
sandbox="$HOME/.config/research-harness/sandbox"
mkdir -p "$sandbox"
for job in kaimon julia-update; do
    render "sandbox/$job.bwrap" "$sandbox/$job.bwrap"
done
# Each write deny of the jobs, an argument after `--ro-bind` below the home directory, and
# julia-update's linux_write directory of sandbox/daemon.toml exist before the jobs start, as
# `harness setup` makes them: bwrap stops at a write deny that is missing, and skips a missing
# linux_write directory, whose writes then stay in the job's empty home. Each directory that
# mkdir creates has mode 700.
for job in kaimon julia-update; do
    previous=
    while IFS= read -r argument; do
        if [ "$previous" = --ro-bind ]; then
            case "$argument" in
                "$HOME"/*) (umask 077 && mkdir -p "$argument") ;;
            esac
        fi
        previous=$argument
    done < "$sandbox/$job.bwrap"
done
(umask 077 && mkdir -p "$HOME/.cache/julia-update")

units="$HOME/.config/systemd/user"
mkdir -p "$units"
for unit in kaimon.service julia-update.service julia-update.timer \
    claude-autocommit.service claude-autocommit.timer; do
    render "systemd/$unit" "$units/$unit"
done
systemctl --user daemon-reload
systemctl --user enable --now kaimon.service julia-update.timer claude-autocommit.timer
# A changed unit takes effect only at a restart, as bootout and bootstrap do on macOS.
systemctl --user restart kaimon.service julia-update.timer claude-autocommit.timer
{{- end }}
